<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#373636">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Автоматическая отправка GPS"
            android:textColor="#E8E8E8"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/gpsDataLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#4A4A4A"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <TextView
                android:id="@+id/tvLatitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Latitude: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/tvLongitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Longitude: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/tvAltitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Altitude: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Time: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/networkDataLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#4A4A4A"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gpsDataLayout">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сетевые параметры:"
                android:textColor="#FFA500"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/tvRSRP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RSRP: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/tvRSRQ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RSRQ: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/tvRSSI"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RSSI: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/tvFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Frequency: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/tvNetworkType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Network: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/tvIPAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IP Address: ожидание..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:padding="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvOfflineCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Оффлайн: 0"
            android:textColor="#FFA500"
            android:textSize="16sp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/networkDataLayout" />

        <TextView
            android:id="@+id/tvSockets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Автоматическая отправка каждые 3 сек"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOfflineCount" />

        <Button
            android:id="@+id/btnCheckPermissions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2196F3"
            android:text="Проверить разрешения"
            android:textColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSockets" />

        <Button
            android:id="@+id/btnRetryOffline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#4CAF50"
            android:text="Отправить оффлайн"
            android:textColor="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCheckPermissions" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>